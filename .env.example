MODEL_API_KEY=
META_API_KEY=
OPEN_WEIGHT_API_KEY=
META_BASE_URL=https://api.meta.ai/v1
MODEL_NAME=muse-spark-1.3
MODEL_PROVIDER=auto
REQUIRE_OPEN_WEIGHT_MODEL=false
UPSTREAM_OPERATIONAL_VERIFIED=false

# Self-hosted Muse Spark Open (vLLM / SGLang / llama.cpp)
# META_BASE_URL=http://127.0.0.1:8080/v1
# MODEL_NAME=meta-models/Muse-Spark-Open-816B-A42B
# MODEL_PROVIDER=self_hosted
# REQUIRE_OPEN_WEIGHT_MODEL=true

# Production: Modal Shared Endpoint serving Meta open weights.
# Create it with `make modal-model`, then copy the endpoint URL and generated
# bearer credential into .env / the Modal secret before deploying GuardMeta.
# META_BASE_URL=https://MODEL-ENDPOINT.modal.run/v1
# MODEL_NAME=meta-models/Muse-Spark-Open-816B-A42B
# MODEL_PROVIDER=modal
# REQUIRE_OPEN_WEIGHT_MODEL=true

# GuardMeta gateway auth. Empty disables inbound auth (local only).
GUARDMETA_API_KEY=

# Runtime
LOG_LEVEL=INFO
MAX_CORRECTION_ATTEMPTS=3
REQUEST_TIMEOUT_SECONDS=90
MAX_PROMPT_CHARS=32000
RATE_LIMIT_PER_MINUTE=60
DEMO_MODE=false
DEMO_RATE_LIMIT_PER_MINUTE=6
FINANCIAL_MAX_AMOUNT=250000.00
ENVIRONMENT=development
